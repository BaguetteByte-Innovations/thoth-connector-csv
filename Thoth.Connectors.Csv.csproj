<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>Thoth.Connectors.Csv</RootNamespace>
		<!-- Version: this connector's own line, derived from the git tags of its public repository
		     (MinVer, standalone builds only). Inside the monorepo it builds as a development version. -->
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<PublishAot>true</PublishAot>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<Platforms>x64</Platforms>
		<InvariantGlobalization>true</InvariantGlobalization>
		<StripSymbols>true</StripSymbols>
		<NoWarn>1701;1702;IDE0270;IDE0305</NoWarn>
	</PropertyGroup>

	<!-- Contract reference: a PackageReference in the standalone public repository, a
	     ProjectReference inside the monorepo. -->
	<ItemGroup Condition="'$(ThothStandalone)' == 'true'">
		<PackageReference Include="Thoth.Integration.Abstractions" VersionOverride="$(ThothAbstractionsVersion)" />
	</ItemGroup>
	<ItemGroup Condition="'$(ThothStandalone)' != 'true'">
		<ProjectReference Include="..\Thoth.Integration.Abstractions\Thoth.Integration.Abstractions.csproj" />
	</ItemGroup>

	<!-- MinVer derives the version from the repository's git tags (build-only, nothing at runtime,
	     so AOT-safe). Referenced in standalone builds only. -->
	<ItemGroup Condition="'$(ThothStandalone)' == 'true'">
		<PackageReference Include="MinVer" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="manifest.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	  <None Update="config.example.json">
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </None>
	</ItemGroup>
</Project>
