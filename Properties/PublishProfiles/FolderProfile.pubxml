<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <!-- Standalone public repository: publish/csv/ at the repository root (ignored by git).
         Monorepo: straight into the engine's connectors-ext scan folder, where it is discovered. -->
    <PublishDir Condition="'$(ThothStandalone)' == 'true'">$(MSBuildProjectDirectory)\publish\csv\</PublishDir>
    <PublishDir Condition="'$(ThothStandalone)' != 'true'">$(MSBuildThisFileDirectory)..\..\..\Thoth.Engine\bin\x64\Release\net10.0-windows\win-x64\connectors-ext\csv\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>